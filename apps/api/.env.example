# Port the API listens on (default: 3001)
PORT=3001

# Comma-separated list of exact origins allowed by CORS.
# Entries of the form https://*.example.com match one subdomain level.
# Default when unset: http://localhost:3000, http://127.0.0.1:3000, https://pigo-web.vercel.app
CORS_ALLOWED_ORIGINS=""
